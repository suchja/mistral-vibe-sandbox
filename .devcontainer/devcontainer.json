{
  "name": "mistral-vibe",

  // Compose-based setup: two services on two networks.
  //   - "vibe" (this devcontainer): only on the internal "sandbox" network,
  //     so it has NO direct route to the host, the LAN, or the internet.
  //   - "proxy" (squid): on both "sandbox" and "egress", so it is the vibe
  //     container's only way out. proxy/squid.conf denies all destinations
  //     in private/reserved ranges, which covers the host (host.docker.internal)
  //     and the LAN, while still allowing the public internet for research.
  "dockerComposeFile": "compose.yaml",
  "service": "vibe",
  "shutdownAction": "stopCompose",

  "workspaceFolder": "/workspaces/MistralVibeBox-FirstTry",

  "remoteUser": "vscode",

  "postCreateCommand": "mkdir -p /home/vscode/.vibe && chown -R vscode:vscode /home/vscode/.vibe && vibe --version",

  // Runs on EVERY container start (postCreateCommand only runs at
  // creation/rebuild). Verifies the sandbox posture - capabilities,
  // no-new-privileges, network isolation, resource limits, mounts, and
  // proxy behavior - and exits non-zero if a security property is
  // violated, so VS Code surfaces an error instead of a silent degrade.
  "postStartCommand": "bash ${containerWorkspaceFolder}/.devcontainer/security-check.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "mistralai.mistral-vibe-code"
      ]
    }
  }
}
